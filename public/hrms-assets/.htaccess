# SPA fallback for /hrms/: any path that isn't a real file (e.g. /hrms/dashboard, a notification deep
# link, a refresh) is served index.html and React Router takes it from there.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /hrms/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /hrms/index.html [L]
</IfModule>

# index.html must never be cached, or browsers keep asking for the old hashed JS after a deploy.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
